{
  "agent": "orchestrator",
  "permissions": {
    "allow": [
      "Bash(uv sync:*)",
      "Bash(uv add:*)",
      "Bash(uv lock:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(uv run pytest -m \"not integration\":*)",
      "Bash(make lint)",
      "Bash(make format)",
      "Bash(make typecheck)",
      "Bash(make test)",
      "Bash(make test-cov)",
      "Bash(make check)",
      "Bash(docker compose -f docker-compose.local.yml ps:*)",
      "Bash(docker compose -f docker-compose.local.yml logs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push origin chore/*)",
      "Bash(git push origin feat/*)",
      "Bash(git push origin fix/*)"
    ],
    "ask": [
      "Bash(make test-integration)",
      "Bash(uv run pytest -m integration:*)",
      "Bash(make up-local)",
      "Bash(make down-local)",
      "Bash(make migrate)"
    ],
    "deny": [
      "Bash(git push origin main)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git reset --hard:*)",
      "Bash(docker system prune:*)",
      "Bash(docker compose -f docker-compose.local.yml down -v:*)",
      "Read(./.env)",
      "Read(./.env.*.local)",
      "Read(./secrets/**)",
      "Bash(docker compose config:*)",
      "Bash(docker compose -f docker-compose.local.yml config:*)",
      "Bash(docker-compose config:*)",
      "Bash(docker inspect:*)",
      "Bash(docker container inspect:*)",
      "Bash(cat .env:*)",
      "Bash(cat ./.env:*)",
      "Bash(source .env:*)",
      "Bash(. .env:*)",
      "Read(**/.env)",
      "Bash(docker exec:*)",
      "Bash(docker compose exec:*)",
      "Bash(docker compose -f docker-compose.local.yml exec:*)",
      "Bash(docker compose -f docker-compose.local.yml run:*)",
      "Bash(printenv:*)",
      "Bash(docker compose --file:*)",
      "Bash(docker compose -p:*)",
      "Bash(docker compose --project-name:*)",
      "Bash(docker compose --env-file:*)",
      "Bash(docker compose -f ./docker-compose.local.yml config:*)",
      "Bash(docker compose -f ./docker-compose.local.yml exec:*)",
      "Bash(docker compose -f ./docker-compose.local.yml run:*)",
      "Bash(docker compose run:*)",
      "Bash(docker run:*)",
      "Bash(docker --context:*)",
      "Bash(docker -c:*)",
      "Bash(docker-compose:*)",
      "Bash(env)",
      "Bash(set)",
      "Bash(export)",
      "Bash(export -p)",
      "Bash(declare -x)",
      "Bash(declare -p:*)",
      "Bash(compgen -e:*)",
      "Bash(less .env:*)",
      "Bash(head .env:*)",
      "Bash(tail .env:*)",
      "Bash(more .env:*)",
      "Bash(sed:* .env)",
      "Bash(awk:* .env)",
      "Bash(grep:* .env)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat docs/pipeline/STATE.md 2>/dev/null || true"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Before compaction: update docs/pipeline/STATE.md and commit.' >&2"
          }
        ]
      }
    ]
  }
}
