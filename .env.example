# =============================================================================
# Nexus Spread Scanner — environment template
#   cp .env.example .env && chmod 600 .env
# docker compose passes each service ONLY the variables it needs.
# NEVER commit .env. API keys must be READ-ONLY (V1); withdrawals always disabled.
# =============================================================================

# ----------------------------------------------------------------- Telegram
# Required by: worker-alerts
TELEGRAM_BOT_TOKEN=
# Numeric chat id; groups/channels are negative, e.g. -1001234567890
TELEGRAM_CHAT_ID=
TELEGRAM_DISABLE_NOTIFICATION=false
# Drop opportunity alerts that waited in the queue longer than this (seconds)
TELEGRAM_ALERT_MAX_AGE_S=30
# Drop system events (exchange down/recovered, start/stop) older than this (seconds)
TELEGRAM_EVENT_MAX_AGE_S=300

# ----------------------------------------------------------------- PostgreSQL
# Required by: postgres, migrator, scanner, worker-alerts, worker-maintenance
# Inside docker compose POSTGRES_HOST is overridden to "postgres".
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nexus
POSTGRES_USER=nexus
# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=

# ----------------------------------------------------------------- Redis / Celery
# Inside docker compose these are overridden to point at the "redis" service.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_TIMEZONE=UTC

# ----------------------------------------------------------------- Logging
LOG_LEVEL=INFO
LOG_JSON_FORMAT=true

# ----------------------------------------------------------------- Exchanges
# Comma-separated or JSON list; at least two. Default = core venues (CORE_EXCHANGES);
# add mexc/bitget explicitly only for extension runs (ADR 0002).
EXCHANGES_ENABLED=["binance","bybit","gateio","kucoin","okx"]
EXCHANGES_REQUEST_TIMEOUT_MS=10000
# Conditional venues: data is collected, but trading there may not be possible now. Every digest
# and alert shows totals for ALL venues and EXCLUDING these. Set explicitly: must be a subset of
# EXCHANGES_ENABLED (scanner fails at startup otherwise, typo guard). Unset/empty: the default list
# is intersected with EXCHANGES_ENABLED (warning conditional_venues_defaulted). "[]" = none.
# Required by: scanner, alerts worker.
CONDITIONAL_VENUES=["bybit","gateio"]

# Read-only API keys (optional; used for deposit/withdrawal status and network fees).
# Required by: scanner only.
BYBIT_API_KEY=
BYBIT_API_SECRET=
BINANCE_API_KEY=
BINANCE_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
GATEIO_API_KEY=
GATEIO_API_SECRET=
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_API_PASSPHRASE=

# Key-policy attestations (default false). Set true ONLY after completing the manual
# attestation steps in docs/guides/stage-1-local-setup.md section 7; otherwise startup is refused
# for that venue when its key is set.
KEY_POLICY_KUCOIN_IP_ATTESTED=false
KEY_POLICY_GATEIO_PERMISSIONS_ATTESTED=false
# MEXC_* / BITGET_* are intentionally absent (extension venues, ADR 0002); see README
# "Extension runs" to add them back.

# ----------------------------------------------------------------- Scanner
# Quote assets treated as USD 1:1 (allowed: USDT, USDC)
SCANNER_QUOTE_ASSETS=USDT
# Optional symbol filters, e.g. BTC/USDT,ETH/USDT
SCANNER_SYMBOLS_WHITELIST=
SCANNER_SYMBOLS_BLACKLIST=
# Skip pairs whose 24h quote volume is below this on either exchange
SCANNER_MIN_QUOTE_VOLUME_USD=50000
# Ticker sweep period (seconds)
SCANNER_TICKER_INTERVAL_S=10
# Markets / fees / transfer status refresh period (seconds)
SCANNER_METADATA_REFRESH_S=1800
# Order book levels fetched per side for depth evaluation
SCANNER_ORDERBOOK_DEPTH=50
# Max candidates evaluated with full order books per sweep
SCANNER_MAX_CANDIDATES_PER_SWEEP=30
SCANNER_MAX_CONCURRENT_REQUESTS_PER_EXCHANGE=4
# Top-K gross spreads stored per sweep for analytics
SCANNER_SNAPSHOT_TOP_K=20
SCANNER_HEARTBEAT_TTL_S=120
# Report an exchange as down after N consecutive failed sweeps
SCANNER_EXCHANGE_DOWN_AFTER_FAILURES=3
# Pause an exchange for N seconds after a rate-limit response (no aggressive retries)
SCANNER_RATE_LIMIT_BACKOFF_S=60
# WebSocket hot-set: legs of routes with a positive net spread are streamed for WS_HOT_TTL_S
SCANNER_WS_ENABLED=true
SCANNER_WS_MAX_STREAMS=20
SCANNER_WS_HOT_TTL_S=300

# ----------------------------------------------------------------- Spread engine
# Alert only when BOTH net conditions hold
SPREAD_MIN_NET_PROFIT_PCT=0.3
SPREAD_MIN_NET_PROFIT_USD=5
# Trade size used to walk order book depth (slippage)
SPREAD_REFERENCE_NOTIONAL_USD=1000
# Discard order books older than this / further apart in time than skew
SPREAD_MAX_ORDERBOOK_AGE_MS=5000
SPREAD_MAX_BOOK_SKEW_MS=3000
# Gross spreads above this are flagged suspicious (ticker collision / delisting), never alerted
SPREAD_MAX_GROSS_SPREAD_PCT=20
# Stricter cap when the transfer path is NOT verified (no API keys / unknown network):
# large unverified spreads are almost always ticker collisions or suspended withdrawals
SPREAD_MAX_UNVERIFIED_GROSS_SPREAD_PCT=5
# Fallback taker fee (%) when the exchange does not report one
SPREAD_DEFAULT_TAKER_FEE_PCT=0.2
# Deduct the cheapest common-network withdrawal fee from the profit
SPREAD_INCLUDE_TRANSFER_COST=true
# On-chain transfer taxes not included in exchange withdrawal fees, percent per asset (JSON).
# Terra Classic burns 1.5 % of every on-chain LUNC/USTC transfer (since 2026-08).
SPREAD_TRANSFER_TAX_PCT={"LUNC": 1.5, "USTC": 1.5}
# If true (default), only opportunities with a verified transfer path are alerted; unverified
# ones are still priced and stored (reported as "unverified" in the daily digest)
SPREAD_REQUIRE_VERIFIED_TRANSFER=true
# One alert per opportunity episode. This cooldown is a floor between first alerts of the
# same route (an episode that closes and reopens quickly does not alert again)
SPREAD_ALERT_COOLDOWN_S=600
# Re-alert an open episode only if its net profit grew by at least N % since the last alert
ALERT_REALERT_GROWTH_PCT=50

# ----------------------------------------------------------------- Episodes
# An opportunity episode (one alert per episode) closes after N seconds without a
# profitable evaluation of its route (routes miss sweeps: keep well above the sweep interval)
EPISODE_CLOSE_GAP_S=300

# ----------------------------------------------------------------- Quarantine
# A route whose opportunity episode stays open this long WITHOUT a verified transfer path
# (e.g. a spread that persists because withdrawals are suspended) is quarantined: it stops
# taking order-book slots and is never alerted. Unavailable transfers quarantine at once.
QUARANTINE_PERSIST_MIN=15
# Quarantine duration; lifted early when the transfer path becomes verified
QUARANTINE_TTL_H=24
# Recurring dead routes: within this window, unverified episodes adding up to
# QUARANTINE_PERSIST_MIN minutes, or this many of them, quarantine the route
QUARANTINE_WINDOW_H=6
QUARANTINE_MAX_EPISODES=5

# ----------------------------------------------------------------- Paper trading
# Simulation only: no exchange access, nothing is ever traded or transferred.
# Every alert is "executed" on REST books taken PAPER_LATENCY_MS later.
PAPER_ENABLED=true
# Shadow portfolios ("venue sets"): independent paper portfolios fed by the same stream, so the
# "without Bybit / without gateio ..." numbers are real counterfactuals. Entries separated by ";":
#   all                     = every venue of EXCHANGES_ENABLED (mandatory)
#   excl_conditional        = enabled minus CONDITIONAL_VENUES
#   excl_gateio=-gateio     = enabled minus gateio      (several: -gateio,-bybit)
#   core3=binance,okx,kucoin = exactly these venues     (do not mix included and -excluded)
# Names: a-z, 0-9, _ (max 32); every venue must be in EXCHANGES_ENABLED; >= 2 venues per set.
# A bad value stops the scanner at startup (fail closed). Each set has its own inventory,
# rebalancing and top-N cap (SCANNER_MAX_CANDIDATES_PER_SWEEP applies inside every set).
# ACCRUAL RULE: a set accrues data only from the moment it is added - no backfill, no
# retroactive history. Removing a set stops accrual; its rows stay in the database.
# NOTE: with an explicit value like this one, the sets are strict: if CONDITIONAL_VENUES is
# empty, `excl_conditional` equals `all` and the scanner refuses to start - drop that entry then.
# RUNS: a set is identified by its definition (venues, capital, sizing, rebalancing). Changing
# any of them (or EXCHANGES_ENABLED / CONDITIONAL_VENUES behind a set) starts a NEW run of that
# name with the full fresh capital; old rows stay but are never restored. Every set therefore
# always has the same capital. If one set cannot resume at startup it is disabled (logged) and
# the others keep running.
PAPER_VENUE_SETS=all;excl_conditional
# The SAME fixed virtual capital for every set, split equally over the set's venues
# (replaces the old per-venue seed that grew with every new route)
PAPER_CAPITAL_USD=10000
# Share of each venue's capital held as USDT; the rest is the coin inventory budget
PAPER_USDT_SHARE_PCT=50
# Coin inventory seeded per route on the sell venue (taken from the venue's coin budget)
PAPER_COIN_PER_ROUTE_USD=250
# The coin budget of a venue holds budget/250 coins. A coin slot idle for this many hours is
# freed (converted back to USDT, cost booked as a "conversion" rebalance) when a new coin needs
# it; 0 = never (then later coins skip as coin_budget_exhausted: first-come lock-in)
PAPER_COIN_IDLE_RELEASE_H=24
# Estimated cost of that conversion (taker fee + half the spread), % of its value
PAPER_CONVERSION_COST_PCT=0.3
PAPER_TRADE_NOTIONAL_USD=1000
# Simulated detection-to-execution latency; also the "survived latency" re-check of episodes
PAPER_LATENCY_MS=2000
# A balance below N % of its start triggers a VIRTUAL transfer (real network fee from
# metadata); the funds are locked for the delay
PAPER_REBALANCE_THRESHOLD_PCT=20
PAPER_REBALANCE_DELAY_MIN=30

# ----------------------------------------------------------------- Maintenance
MAINTENANCE_SNAPSHOT_RETENTION_DAYS=7
MAINTENANCE_EVALUATION_RETENTION_DAYS=30
# Closed opportunity episodes and quarantine history (paper trades/transfers are kept)
MAINTENANCE_EPISODE_RETENTION_DAYS=90
MAINTENANCE_CLEANUP_INTERVAL_S=3600

# ----------------------------------------------------------------- Daily digest
# Telegram summary of the last 24 h (episodes, paper P&L, quarantines, uptime, coverage)
DIGEST_ENABLED=true
# Local time HH:MM in DIGEST_TZ (IANA zone name)
DIGEST_TIME=09:00
DIGEST_TZ=Europe/Moscow
