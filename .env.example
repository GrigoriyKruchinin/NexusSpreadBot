# =============================================================================
# Nexus Spread Scanner - environment template (SECRETS and ENV-ONLY values)
#
#   cp .env.example .env && chmod 600 .env     then fill section 1 below.
#
# Sections:  1. REQUIRED   2. OPTIONAL read-only exchange keys   3. ADVANCED
# Everything tunable (thresholds, venues, intervals, retention, log level ...) lives in the
# committed file config/nexus.toml, NOT here. An environment variable with the same name would
# override that file, so do not add setting lines to .env.
# NEVER commit .env or paste its contents into chats/issues.
# Fake examples below are obviously fake; the app rejects them at startup.
# =============================================================================

# =============================================================================
# 1. REQUIRED
# =============================================================================

# --- Telegram bot token -------------------------------------------------------
# Purpose: lets Nexus send alerts as your own bot.
# Get it: open @BotFather in Telegram, send /newbot, follow the prompts, copy the token.
# Format: <digits>:<20+ letters/digits/_/->, e.g. 123456789:AAFakeFakeFakeFakeFakeFakeFake
TELEGRAM_BOT_TOKEN=

# --- Telegram chat or channel id ----------------------------------------------
# Purpose: where alerts are delivered (a private chat, a group, or a channel).
# Private chat: write /start to your bot, then ask @userinfobot for your id -> positive number,
#   e.g. 123456789
# Group or channel: ids are NEGATIVE and start with -100, e.g. -1001234567890.
#   Channel steps: create the channel, add your bot as an ADMINISTRATOR with the right
#   "Post messages" (and "Edit messages of others") enabled; then forward any channel post to
#   @userinfobot (or @RawDataBot) and copy the "-100..." chat id. A public channel may also be
#   given as @channel_name.
TELEGRAM_CHAT_ID=

# --- PostgreSQL password ------------------------------------------------------
# Purpose: password of the bundled database (min 12 characters).
# Generate: openssl rand -base64 32
# Host/port/db/user are settings in config/nexus.toml ([postgres]).
POSTGRES_PASSWORD=

# =============================================================================
# 2. OPTIONAL read-only exchange keys (per venue)
# =============================================================================
# Leave a venue EMPTY = public mode: order books and prices still work, but transfer fee and
# deposit/withdrawal status are not read, so alerts for that venue are less precise.
# Filling a venue unlocks its transfer-fee and deposit/withdrawal-status metadata.
# Create keys with READ-ONLY permission; withdrawals/trading must stay DISABLED.
# Key and secret must be set together (an extra passphrase only where the venue uses one).

# Binance
BINANCE_API_KEY=
BINANCE_API_SECRET=

# OKX (passphrase is chosen by you when creating the key)
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# KuCoin (passphrase is chosen by you when creating the key)
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_API_PASSPHRASE=

# Bybit
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Gate.io
GATEIO_API_KEY=
GATEIO_API_SECRET=

# Key check is automatic (read-only, no withdraw/transfer, not too broad); no flags needed.
# A key that fails it is NOT used: that venue runs in public mode and you get a warning.
# Optional, for your own setup: true = a rejected key stops the start and an IP whitelist is
# required (also refuses venues whose API cannot show it: KuCoin IP, Gate.io scopes).
KEY_POLICY_STRICT=false

# =============================================================================
# 3. ADVANCED - leave the defaults when you use docker compose
# =============================================================================
# URLs may embed a password, so they are secrets. Inside docker compose they are overridden to
# the "redis" service automatically.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# MEXC_* / BITGET_* are intentionally absent (extension venues, ADR 0002).
