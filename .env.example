# =============================================================================
# Nexus Spread Scanner - environment template (SECRETS and ENV-ONLY values)
#   cp .env.example .env && chmod 600 .env
# Everything tunable (thresholds, venues, intervals, paper settings, retention, log level ...)
# lives in the committed file config/nexus.toml. An environment variable with the same name
# still overrides a key there, so DELETE leftover setting lines from an old .env.
# docker compose passes each service ONLY the variables it needs.
# NEVER commit .env. API keys must be READ-ONLY (V1); withdrawals always disabled.
# =============================================================================

# ----------------------------------------------------------------- Telegram
# Required by: worker-alerts
TELEGRAM_BOT_TOKEN=
# ENV-ONLY (personal identifier). Numeric chat id; groups/channels are negative,
# e.g. -1001234567890
TELEGRAM_CHAT_ID=

# ----------------------------------------------------------------- PostgreSQL
# Required by: postgres, migrator, scanner, worker-alerts, worker-maintenance
# Host/port/db/user are settings in config/nexus.toml ([postgres]).
# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=

# ----------------------------------------------------------------- Redis / Celery
# URLs may embed a password, so they are secrets. Defaults point at localhost; inside docker
# compose they are overridden to the "redis" service.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# Read-only API keys (optional; used for deposit/withdrawal status and network fees).
# Required by: scanner only.
BYBIT_API_KEY=
BYBIT_API_SECRET=
BINANCE_API_KEY=
BINANCE_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
GATEIO_API_KEY=
GATEIO_API_SECRET=
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_API_PASSPHRASE=

# ENV-ONLY human attestations (default false). Set true ONLY after completing the manual
# attestation steps in docs/guides/stage-1-local-setup.md section 7; otherwise startup is refused
# for that venue when its key is set. They must stay next to the key they attest.
KEY_POLICY_KUCOIN_IP_ATTESTED=false
KEY_POLICY_GATEIO_PERMISSIONS_ATTESTED=false
# Local only; never on a server (A5d guard). Waives only the IP-binding rules (docs/tasks/track0/A6-key-policy-startup-check.md, KP-W).
KEY_POLICY_IP_BINDING_WAIVED=false
# MEXC_* / BITGET_* are intentionally absent (extension venues, ADR 0002); see README
# "Extension runs" to add them back.
