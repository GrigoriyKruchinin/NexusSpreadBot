# Nexus Spread Scanner — developer commands.
SHELL := /bin/bash
COMPOSE_LOCAL := docker compose -f docker-compose.local.yml
SRC := src tests

.DEFAULT_GOAL := help

.PHONY: help
help: ## Show available targets
	@grep -E '^[a-zA-Z_-]+:.*?## ' $(MAKEFILE_LIST) | \
		awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-14s\033[0m %s\n", $$1, $$2}'

# ---------------------------------------------------------------- quality
.PHONY: install lint format typecheck test test-cov test-integration check
install: ## Install all dependencies (incl. dev)
	uv sync

lint: ## Lint with ruff
	uv run ruff format --check $(SRC)
	uv run ruff check $(SRC)

format: ## Auto-format and fix lint issues
	uv run ruff format $(SRC)
	uv run ruff check --fix $(SRC)

typecheck: ## Static type check (mypy --strict)
	uv run mypy src tests

test: ## Run unit tests
	uv run pytest -q -m "not integration"

test-cov: ## Run unit tests with coverage
	uv run pytest -q -m "not integration" --cov --cov-report=term-missing

test-integration: ## Run integration tests (requires `make up-local`)
	uv run pytest -q -m integration

check: lint typecheck test ## Lint + typecheck + unit tests

# ---------------------------------------------------------------- docker (local)
.PHONY: check-env-settings up-local down-local ps-local logs migrate revision
check-env-settings: ## Print NAMES of setting lines left in .env (values never shown)
	@uv run python -m nexus.config.provenance

up-local: check-env-settings ## Build and start the local stack
	@mkdir -p -m 755 "$$HOME/nexus-backup-status"
	$(COMPOSE_LOCAL) up -d --build

down-local: ## Stop the local stack (volumes are kept)
	$(COMPOSE_LOCAL) down

ps-local: ## Show local stack status
	$(COMPOSE_LOCAL) ps

logs: ## Follow logs: make logs s=scanner
	$(COMPOSE_LOCAL) logs -f --tail=200 $(s)

migrate: ## Apply DB migrations in the local stack
	$(COMPOSE_LOCAL) run --rm migrator

revision: ## Create an autogenerated migration: make revision m="message"
	uv run alembic revision --autogenerate -m "$(m)"

# ---------------------------------------------------------------- backups (A5a)
.PHONY: backup backup-archive restore-drill bootstrap-roles
backup: ## pg_dump of live DB to ~/nexus-backups (read-only, needs running stack)
	scripts/backup.sh

backup-archive: ## One-off dump to ~/nexus-backups/archive (never pruned); SOURCE_DB=<db> to pick the database
	BACKUP_ARCHIVE=1 scripts/backup.sh

restore-drill: ## Restore latest dump into nexus_test ONLY and compare row counts
	scripts/restore_drill.sh

bootstrap-roles: ## Create backup/test roles + nexus_test DB (idempotent; run after migrations on a fresh DB)
	@$(COMPOSE_LOCAL) ps --status running --services | grep -qx postgres || \
		{ echo "ERROR: postgres is not running (start the stack first: make up-local)" >&2; exit 1; }
	$(COMPOSE_LOCAL) exec -T postgres sh -c 'psql -q -U "$$POSTGRES_USER" -d postgres -v ON_ERROR_STOP=1' < scripts/sql/bootstrap_backup_roles.sql
