# Nexus Spread Scanner — developer commands.
SHELL := /bin/bash
COMPOSE := docker compose
SRC := src tests

.DEFAULT_GOAL := help

.PHONY: help
help: ## Show available targets
	@grep -E '^[a-zA-Z_-]+:.*?## ' $(MAKEFILE_LIST) | \
		awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-14s\033[0m %s\n", $$1, $$2}'

# ---------------------------------------------------------------- quality
.PHONY: install lint format typecheck test test-cov test-integration check
install: ## Install all dependencies (incl. dev)
	uv sync

lint: ## Lint with ruff
	uv run ruff format --check $(SRC)
	uv run ruff check $(SRC)

format: ## Auto-format and fix lint issues
	uv run ruff format $(SRC)
	uv run ruff check --fix $(SRC)

typecheck: ## Static type check (mypy --strict)
	uv run mypy src tests

test: ## Run unit tests
	uv run pytest -q -m "not integration"

test-cov: ## Run unit tests with coverage
	uv run pytest -q -m "not integration" --cov --cov-report=term-missing

test-integration: ## Run integration tests (requires a test DB, see CLAUDE.md)
	uv run pytest -q -m integration

check: lint typecheck test ## Lint + typecheck + unit tests

# ---------------------------------------------------------------- docker (the tool)
.PHONY: check-env-settings up doctor down ps logs migrate reset-data revision
check-env-settings: ## Print NAMES of setting lines left in .env (values never shown)
	@uv run python -m nexus.config.provenance

up: ## One command: check .env, build, migrate, start everything (scripts/start.sh)
	@scripts/start.sh

doctor: ## Full setup check incl. database and migrations (stack must be up); add ARGS=--send-test to ping the chat
	$(COMPOSE) --profile tools run --rm check nexus check $(ARGS)

down: ## Stop the stack (data volumes are KEPT)
	$(COMPOSE) down

ps: ## Show stack status
	$(COMPOSE) ps

reset-data: ## DANGER: delete the database and Redis volumes (asks for confirmation, run it yourself)
	@echo "WARNING: this DELETES all stored data (database and Redis volumes) of this stack."
	@read -r -p "Type DELETE to continue: " answer && [ "$$answer" = "DELETE" ] || { echo "Aborted."; exit 1; }
	$(COMPOSE) down --volumes

logs: ## Follow logs: make logs s=scanner
	$(COMPOSE) logs -f --tail=200 $(s)

migrate: ## Re-run DB migrations manually (make up already does it)
	$(COMPOSE) run --rm migrator

revision: ## Create an autogenerated migration: make revision m="message"
	uv run alembic revision --autogenerate -m "$(m)"

# ---------------------------------------------------------------- backups (A5a)
.PHONY: backup backup-archive restore-drill bootstrap-roles
backup: ## pg_dump of live DB to ~/nexus-backups (read-only, needs running stack)
	scripts/backup.sh

backup-archive: ## One-off dump to ~/nexus-backups/archive (never pruned); SOURCE_DB=<db> to pick the database
	BACKUP_ARCHIVE=1 scripts/backup.sh

restore-drill: ## Restore latest dump into nexus_test ONLY and compare row counts
	scripts/restore_drill.sh

bootstrap-roles: ## Create backup/test roles + nexus_test DB (idempotent; optional dev tool, run after `make up`)
	@$(COMPOSE) ps --status running --services | grep -qx postgres || \
		{ echo "ERROR: postgres is not running (start the stack first: make up)" >&2; exit 1; }
	$(COMPOSE) exec -T postgres sh -c 'psql -q -U "$$POSTGRES_USER" -d postgres -v ON_ERROR_STOP=1' < scripts/sql/bootstrap_backup_roles.sql
